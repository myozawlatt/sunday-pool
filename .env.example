# Copy to .env.local and fill in. Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only for `npm run seed` on your own machine. Never commit it or add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Any long random string. Add the same value in Vercel → Settings → Environment Variables
# so the daily keep-alive cron is authorised.
CRON_SECRET=
